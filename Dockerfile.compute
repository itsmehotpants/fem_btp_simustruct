FROM dolfinx/dolfinx:stable AS base

WORKDIR /app

# Install Python dependencies
COPY requirements_compute.txt .
RUN pip install --no-cache-dir -r requirements_compute.txt

# Copy source code
COPY src/ ./src/
COPY models/ ./models/
COPY compute_engine/main.py .

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
